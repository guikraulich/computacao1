var nome: texto
var ano_nascimento: inteiro
const ano = 2026
var salario: real
var usa_oculos: lógico = falso
var resposta = texto

para (var i=1; i<4; i=i+1){
    nome = leia("Qual é o seu nome?")
    ano_nascimento = inteiro(leia("Qual o seu ano de nascimento?"))
    salario = real(leia("Qual o seu salário mensal?"))
    resposta = leia("Você usa óculos? V ou F")

se (resposta=='V'){
   usa_oculos = verdadeiro
} 

se (usa_oculos) {
    escreva("${i} - ${nome} tem ${ano - ano_nascimento} anos, ganha R$ ${salario} e usa óculos.")
} senao {
    escreva("${i} - ${nome} tem ${ano - ano_nascimento} anos, ganha R$ ${salario} e não usa óculos")
}
    
}
